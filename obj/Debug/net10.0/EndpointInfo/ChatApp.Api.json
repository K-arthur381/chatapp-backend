            },
            "nullable": true
          },
          "currentUserReaction": {
            "type": "string",
            "nullable": true
          },
          "readCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalParticipants": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
